---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const notepads = await getCollection('notepads');
const title = "Python Script Notepads";
const description = "Browse annotated Python scripts with syntax highlighting, walkthroughs, and documentation.";
---

<Layout 
  title={title} 
  description={description}
  searchMode="collapsed"
  pageType="notepad"
>
  <div class="container mx-auto px-4 py-8 w-full">
    <nav class="mb-6">
      <a href={import.meta.env.BASE_URL} class="text-vsc-accent-blue hover:underline">← Home</a>
    </nav>
    
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold mb-4 text-vsc-accent-blue">Python Script Notepads</h1>
      <p class="text-vsc-text-secondary max-w-2xl mx-auto">
        Explore our collection of Python scripts with detailed annotations, syntax highlighting, and comprehensive documentation.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
      {notepads.map((notepad) => (
        <div class="bg-vsc-bg-medium p-6 rounded-lg border border-vsc-border-light hover:border-vsc-accent-blue transition-all duration-300 hover:shadow-lg group">
          <h2 class="text-xl font-semibold mb-3">
            <a href={`${import.meta.env.BASE_URL}/notepads/${notepad.data.id}`} class="text-vsc-text-primary group-hover:text-vsc-accent-blue transition-colors">
              {notepad.data.title}
            </a>
          </h2>
          <p class="text-vsc-text-secondary mb-4 text-sm leading-relaxed min-h-[3rem]">
            {notepad.data.description.length > 150 
              ? notepad.data.description.substring(0, 150) + '...' 
              : notepad.data.description}
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            {notepad.data.tags.map((tag) => (
              <span class="px-2 py-1 bg-vsc-bg-light text-xs rounded text-vsc-text-secondary hover:bg-vsc-bg-dark transition-colors">
                {tag}
              </span>
            ))}
          </div>
          <div class="border-t border-vsc-border-light pt-4 mt-4">
            <div class="flex justify-between items-center text-xs text-vsc-text-secondary">
              <div>
                <div class="mb-1">Author: <span class="text-vsc-text-primary">{notepad.data.author}</span></div>
                <div>Updated: <span class="text-vsc-text-primary">{new Date(notepad.data.lastUpdated).toLocaleDateString()}</span></div>
              </div>
              <div class="text-right">
                <div class="mb-1">Dependencies: <span class="text-vsc-text-primary">{notepad.data.dependencies.length}</span></div>
                <div>
                  {notepad.data.annotationsFile ? (
                    <span class="inline-flex items-center gap-1 text-vsc-accent-blue">
                      📍 Annotated
                    </span>
                  ) : (
                    <span class="text-vsc-text-secondary">No annotations</span>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    {notepads.length === 0 && (
      <div class="text-center py-12">
        <div class="text-6xl mb-4">📔</div>
        <h2 class="text-2xl font-semibold mb-4 text-vsc-text-primary">No Notepads Found</h2>
        <p class="text-vsc-text-secondary">There are no notepads available at the moment.</p>
      </div>
    )}
  </div>
</Layout>