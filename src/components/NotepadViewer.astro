---
import { processFile } from '../utils/file-helpers';

interface Props {
  notepad: any;
  showSplit?: boolean;
}

const { notepad, showSplit = true } = Astro.props;

// Process the Python script file
const processedScript = await processFile(notepad.filePath);

// Process README if it exists
let processedReadme = null;
if (notepad.readmeFile) {
  try {
    processedReadme = await processFile(notepad.readmeFile);
  } catch (error) {
    console.warn(`Could not process README: ${notepad.readmeFile}`);
  }
}

// Load annotations if they exist
let annotations = null;
if (notepad.annotationsFile) {
  try {
    const fs = await import('fs/promises');
    const annotationData = await fs.readFile(notepad.annotationsFile, 'utf-8');
    annotations = JSON.parse(annotationData);
  } catch (error) {
    console.warn(`Could not load annotations: ${notepad.annotationsFile}`);
  }
}

// Provide sample annotations for arcgis_utils
if (!annotations && notepad.id === 'arcgis_utils') {
  annotations = {
    "annotations": [
      {
        "line": 15,
        "title": "Enterprise Connection Setup",
        "description": "This section configures secure enterprise connections with SSL certificate validation and credential management for production environments.",
        "code": "def setup_enterprise_connection(portal_url, username, password):\n    # Validate SSL certificates for security\n    ssl_context = ssl.create_default_context()",
        "tip": "Always validate SSL certificates in production to prevent man-in-the-middle attacks."
      },
      {
        "line": 45,
        "title": "Performance Monitoring",
        "description": "Built-in performance monitoring tracks connection times, request latencies, and resource usage to optimize enterprise workflows.",
        "code": "@performance_monitor\ndef execute_gis_operation(operation_type, data):\n    start_time = time.time()\n    # Monitor execution time",
        "tip": "Performance monitoring helps identify bottlenecks in large-scale GIS operations."
      },
      {
        "line": 78,
        "title": "Secure Credential Handling", 
        "description": "Credentials are encrypted and stored securely using enterprise-grade encryption standards with automatic rotation support.",
        "code": "def encrypt_credentials(username, password):\n    # Use enterprise encryption standards\n    cipher = Fernet(generate_key())\n    encrypted_data = cipher.encrypt(password.encode())",
        "tip": "Never store credentials in plain text - always use proper encryption."
      },
      {
        "line": 120,
        "title": "Error Recovery System",
        "description": "Robust error handling with automatic retry logic, graceful degradation, and comprehensive logging for enterprise reliability.",
        "code": "try:\n    result = execute_operation()\nexcept ConnectionError as e:\n    logger.error(f\"Connection failed: {e}\")\n    # Implement retry logic",
        "tip": "Implement exponential backoff for retries to avoid overwhelming servers."
      }
    ]
  };
}
---

<div class="flex-1 flex overflow-hidden" data-notepad-container>
  <!-- Floating Annotation Notepad (Left) - only visible when code section is in view -->
  <div class="w-1/5 p-2 relative hidden" data-line-annotations-panel>
    <div class="sticky top-4">
      <!-- Animated Notepad -->
      <div class="bg-vsc-bg-light dark:bg-gray-800 border border-vsc-border-light dark:border-gray-600 rounded-lg shadow-lg transform transition-all duration-300 ease-in-out opacity-0 scale-95" data-annotation-notepad>
        <!-- Notepad Header -->
        <div class="bg-vsc-bg-medium dark:bg-gray-700 px-3 py-2 border-b border-vsc-border-light dark:border-gray-600 rounded-t-lg flex items-center">
          <span class="text-sm text-vsc-text-primary dark:text-gray-200 font-medium flex items-center">
            📝 <span class="ml-1">Note</span>
          </span>
          <div class="ml-auto w-2 h-2 bg-blue-500 dark:bg-blue-400 rounded-full shadow-sm"></div>
        </div>
        
        <!-- Notepad Content -->
        <div class="p-3">
          <div class="text-xs text-vsc-text-secondary dark:text-gray-400 mb-1 font-mono" data-annotation-lines>
            Lines 24-29
          </div>
          <div class="text-sm text-vsc-text-primary dark:text-gray-300 leading-relaxed" data-annotation-text>
            <!-- Current annotation content will appear here -->
          </div>
          
          <!-- Notepad lines effect -->
          <div class="mt-3 space-y-1">
            <div class="h-px bg-vsc-border-light dark:bg-gray-600 opacity-30"></div>
            <div class="h-px bg-vsc-border-light dark:bg-gray-600 opacity-20"></div>
            <div class="h-px bg-vsc-border-light dark:bg-gray-600 opacity-10"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Code Panel (Center 60% in walkthrough, full width otherwise) -->
  <div class="flex-1 flex flex-col overflow-hidden" data-code-panel>
    <div class="bg-vsc-bg-medium rounded-lg border border-vsc-border-light h-full flex flex-col">
      <!-- Header (Fixed) -->
      <div class="bg-vsc-bg-light px-4 py-2 border-b border-vsc-border-light rounded-t-lg flex items-center justify-between flex-shrink-0">
        <span class="text-sm text-vsc-text-secondary font-mono">{notepad.filePath}</span>
        <div class="flex items-center gap-2">
          <span class="text-xs px-2 py-1 bg-vsc-bg-dark rounded text-vsc-text-secondary font-mono">
            {processedScript.language}
          </span>
          <button 
            data-copy-code
            class="text-xs px-3 py-1 bg-green-600 text-white rounded hover:bg-green-700 transition-colors font-medium"
            title="Copy code to clipboard"
          >
            📋 Copy
          </button>
          {annotations && (
            <button 
              data-walkthrough-start
              class="text-xs px-3 py-1 bg-vsc-accent-blue text-white rounded hover:bg-blue-600 transition-colors font-medium"
            >
              🚀 Start Walkthrough
            </button>
          )}
          {annotations && (
            <button 
              data-annotations-view
              class="text-xs px-3 py-1 bg-purple-600 text-white rounded hover:bg-purple-700 transition-colors font-medium"
            >
              📋 Annotations
            </button>
          )}
          {annotations && (
            <button 
              data-walkthrough-exit
              class="text-xs px-3 py-1 bg-red-700 text-white rounded hover:bg-red-800 transition-colors font-medium hidden"
            >
              ✕ Exit Walkthrough
            </button>
          )}
          {annotations && (
            <button 
              data-annotations-exit
              class="text-xs px-3 py-1 bg-red-700 text-white rounded hover:bg-red-800 transition-colors font-medium hidden"
            >
              ✕ Exit Annotations
            </button>
          )}
        </div>
      </div>
      
      <!-- Scrollable Code Content -->
      <div class="flex-1 overflow-auto" data-code-scroll-container>
        <div class="flex">
          <!-- Line Numbers -->
          <div class="bg-vsc-bg-dark text-vsc-text-secondary font-mono select-none border-r border-vsc-border-light flex-shrink-0" 
               data-line-numbers 
               style="padding: 16px 8px 16px 16px; min-width: 48px; text-align: right; white-space: pre; font-family: Monaco, Menlo, 'Ubuntu Mono', Consolas, monospace; font-size: 14px; line-height: 1.5; letter-spacing: 0;">
            <!-- Line numbers will be populated here -->
          </div>
          <!-- Code Content -->
          <div class="flex-1" style="padding: 16px 16px 16px 8px; min-height: 100%;">
            <pre class="relative" data-code-container style="margin: 0; padding: 0; font-family: Monaco, Menlo, 'Ubuntu Mono', Consolas, monospace; font-size: 14px; line-height: 1.5; letter-spacing: 0;"><code 
              class="hljs language-{processedScript.language}" 
              data-code-content
              style="line-height: 1.5; display: block; font-family: inherit; font-size: inherit; letter-spacing: 0;"
              set:html={processedScript.html}
            ></code></pre>
          </div>
        </div>
        
      </div>
    </div>
  </div>

  <!-- Resizable Divider -->
  {showSplit && processedReadme && (
    <div class="w-1 bg-vsc-border-light hover:bg-vsc-accent-blue cursor-col-resize transition-colors relative group" data-splitter>
      <div class="absolute inset-y-0 -left-1 -right-1 group-hover:bg-vsc-accent-blue group-hover:bg-opacity-20"></div>
    </div>
  )}

  <!-- README Panel (Right) - if exists and not in walkthrough mode -->
  {showSplit && processedReadme && (
    <div class="flex-1 p-4 overflow-auto" data-readme-panel>
      <div class="bg-vsc-bg-medium rounded-lg border border-vsc-border-light h-full flex flex-col">
        <div class="bg-vsc-bg-light px-4 py-2 border-b border-vsc-border-light rounded-t-lg">
          <span class="text-sm text-vsc-text-secondary font-mono">README.md</span>
        </div>
        <div class="p-4 flex-1 overflow-auto">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs text-vsc-text-secondary">Markdown Preview</span>
            <button 
              data-toggle-raw-readme
              class="px-2 py-1 text-xs bg-vsc-bg-light border border-vsc-border-light rounded hover:bg-vsc-bg-medium transition-colors text-vsc-text-secondary"
            >
              📄 Raw
            </button>
          </div>
          <div data-readme-preview class="vscode-markdown-preview">
            <div set:html={processedReadme.html}></div>
          </div>
          <div data-readme-raw class="hidden">
            <pre class="text-sm bg-vsc-bg-dark p-4 rounded border border-vsc-border-light overflow-auto font-mono text-vsc-text-primary whitespace-pre-wrap">{processedReadme.content}</pre>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- Walkthrough Annotations Panel (Right 20%) - shown in walkthrough mode -->
  {annotations && (
    <div class="w-1/5 p-2 overflow-auto hidden" data-walkthrough-panel>
      <div class="bg-vsc-bg-medium rounded-lg border border-vsc-border-light h-full flex flex-col">
        <div class="bg-vsc-bg-light px-3 py-2 border-b border-vsc-border-light rounded-t-lg flex items-center justify-between">
          <span class="text-sm text-vsc-text-primary font-medium">🧭 Walkthrough</span>
          <button data-walkthrough-close class="text-vsc-text-secondary hover:text-vsc-text-primary text-lg">×</button>
        </div>
        
        <!-- Walkthrough Navigation -->
        <div class="px-3 py-2 border-b border-vsc-border-light bg-vsc-bg-dark">
          <div class="flex items-center justify-between mb-2">
            <div class="text-xs text-vsc-text-secondary">
              Step <span data-current-step>1</span> of <span data-total-steps>{annotations.walkthrough?.steps?.length || 0}</span>
            </div>
            <div class="flex gap-1">
              <button data-walkthrough-prev class="px-1 py-1 text-xs bg-vsc-bg-light border border-vsc-border-light rounded hover:bg-vsc-bg-medium transition-colors disabled:opacity-50" disabled>
                ←
              </button>
              <button data-walkthrough-next class="px-1 py-1 text-xs bg-vsc-accent-blue text-white rounded hover:bg-blue-600 transition-colors">
                →
              </button>
            </div>
          </div>
          <div class="w-full bg-vsc-bg-light rounded-full h-1">
            <div data-progress-bar class="bg-vsc-accent-blue h-1 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>
        
        <!-- Current Walkthrough Step Content -->
        <div class="flex-1 p-2 overflow-auto">
          <div data-walkthrough-content>
            <!-- Current walkthrough step will be displayed here -->
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- Standalone Annotations Panel (Right 20%) - shown in annotations mode -->
  {annotations && (
    <div class="w-1/5 p-2 overflow-auto hidden" data-annotations-panel>
      <div class="bg-vsc-bg-medium rounded-lg border border-vsc-border-light h-full flex flex-col">
        <div class="bg-vsc-bg-light px-3 py-2 border-b border-vsc-border-light rounded-t-lg flex items-center justify-between">
          <span class="text-sm text-vsc-text-primary font-medium">📋 Annotations</span>
          <button data-annotations-close class="text-vsc-text-secondary hover:text-vsc-text-primary text-lg">×</button>
        </div>
        
        <!-- Annotations List -->
        <div class="flex-1 p-2 overflow-auto" data-annotations-list>
          <!-- Annotations will be populated here -->
        </div>
      </div>
    </div>
  )}
</div>

<!-- Embed annotations data for JavaScript -->
{annotations && (
  <script type="application/json" data-annotations set:html={JSON.stringify(annotations)}></script>
)}

<style>
  /* Consolidated highlighting styles */
