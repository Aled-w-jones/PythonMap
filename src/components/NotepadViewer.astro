  }

  /* Enhanced Horizontal Rule */
  .vscode-markdown-preview hr {
    height: 0.25em !important;
    padding: 0 !important;
    margin: 24px 0 !important;
    background-color: #21262d !important;
    border: 0 !important;
    border-radius: 2px !important;
  }

  /* Enhanced Text Formatting */
  .vscode-markdown-preview strong {
    font-weight: 600 !important;
    color: #f0f6fc !important;
  }

  .vscode-markdown-preview em {
    font-style: italic !important;
    color: #e6edf3 !important;
  }

  /* Enhanced Images */
  .vscode-markdown-preview img {
    max-width: 100% !important;
    height: auto !important;
    border-radius: 6px !important;
    border: 1px solid #30363d !important;
    margin: 16px 0 !important;
  }

  /* Task Lists */
  .vscode-markdown-preview input[type="checkbox"] {
    margin: 0 0.2em 0.25em -1.6em !important;
    vertical-align: middle !important;
    accent-color: #1f6feb !important;
  }

  /* Keyboard Keys */
  .vscode-markdown-preview kbd {
    display: inline-block !important;
    padding: 3px 5px !important;
    font-size: 11px !important;
    line-height: 10px !important;
    color: #e6edf3 !important;
